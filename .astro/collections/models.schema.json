{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "cover": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "alt"
      ]
    },
    "parts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "原裝",
              "殺肉",
              "第三方改件",
              "膠板/補土自制",
              "3D打印",
              "其他"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "source",
          "type"
        ]
      }
    },
    "paints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "shadow": {
            "type": "string"
          },
          "topcoat": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "brand",
          "code"
        ]
      }
    },
    "lang": {
      "default": "zh",
      "type": "string",
      "enum": [
        "zh",
        "en"
      ]
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "pinned": {
      "default": false,
      "type": "boolean"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "seriesOrder": {
      "type": "number"
    },
    "translationKey": {
      "type": "string"
    },
    "xUrl": {
      "type": "string",
      "format": "uri"
    },
    "hpoiUrl": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate"
  ]
}